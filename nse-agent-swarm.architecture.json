  "cards": [
    {
      "dot": "cyan",
      "title": "How the swarm is created",
      "items": [
        "~10,000 concurrent agents split into groups that only message inside their group",
        "Groups seeded with rival framings: prove smoothness (A/B) or construct breakdown (C/D)",
        "~100-agent Euler warm-up (~50 h) proved unforced blowup and set the direction"
      ]
    },
    {
      "dot": "amber",
      "title": "How an agent is programmed",
      "items": [
        "Internal model stronger than GPT-6 Astra; agents switched to a newer checkpoint mid-run",
        "Tools: cached internet snapshot + code execution in an isolated environment",
        "Humans configure groups and reallocate compute; Codex merges ideas across groups"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the answer is checked",
      "items": [
        "GPT-6 Astra formalized both papers in Lean 4 in 17 h: 2,659 .lean files, ~641k lines, sorry_count 0",
        "Comparator replays the named theorems against Formal Conjectures reference statements via nanoda; results published at github.com/openai/NavierStokesAndEuler",
        "Axioms limited to propext, Quot.sound, Classical.choice; review status self-assessed"
      ]
    }
